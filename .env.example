# Environment Configuration Example
PROJECT_NAME="TRAVELENS"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (SQLite default for dev; PostgreSQL for production)
DATABASE_URL="sqlite:///./travelens.db"

# Security & Authentication
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="*"

# Frontend Configuration (for React / Vite client)
# In production, set to your deployed backend URL (e.g. https://travelens-backend.onrender.com)
VITE_API_BASE_URL=""

# Server
HOST="127.0.0.1"
PORT=8000
